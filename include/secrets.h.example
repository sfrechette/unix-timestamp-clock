#pragma once

// WiFi credentials — fill in before flashing
#define WIFI_SSID     "your_network_name"
#define WIFI_PASSWORD "your_password"

// BLE provisioning PIN — must be written to the PIN characteristic before
// SSID/password changes are accepted. Change this to something only you know.
#define BLE_PIN       "12345"

// Timezone string (POSIX format)
// US Eastern (auto DST): "EST5EDT,M3.2.0,M11.1.0"
// US Pacific:            "PST8PDT,M3.2.0,M11.1.0"
// US Central:            "CST6CDT,M3.2.0,M11.1.0"
// US Mountain:           "MST7MDT,M3.2.0,M11.1.0"
// Central Europe:        "CET-1CEST,M3.5.0,M10.5.0/3"
// Japan:                 "JST-9"
// UTC:                   "UTC0"
#define TIMEZONE_STR  "EST5EDT,M3.2.0,M11.1.0"
